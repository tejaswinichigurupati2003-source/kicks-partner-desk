# Copy to .env.local and fill in. Never commit .env.local.

# Signs private applicant status links. Any long random string.
STATUS_SECRET=

# AI assistant (Google Gemini models only, through OpenRouter).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
AI_ENABLED=true

# Live market notes on the Market page (LangSearch web search).
LANGSEARCH_API_KEY=

# Saving results on the server (Neon Postgres, pooled connection string).
DATABASE_URL=

# Protects the daily clean-up at /api/cron/purge.
CRON_SECRET=
