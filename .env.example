# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres pooled connection string. Tables are created on first use.
DATABASE_URL=

# Assistant (Google Gemini models only, through OpenRouter).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
AI_ENABLED=true

# Live market notes on the Market page.
LANGSEARCH_API_KEY=

# Protects the daily clean-up at /api/cron/purge.
CRON_SECRET=
